generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String?           @unique
  googleId        String?           @unique
  whatsappNumber  String?           @unique
  profileJson     Json?
  goalStage       String            @default("goal_identified")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  conversationLogs ConversationLog[]
  savedOpportunities SavedOpportunity[]
}

model Opportunity {
  id               String            @id @default(uuid())
  title            String
  sponsor          String
  hostCountry      String
  degreeLevel      String[]          // e.g., ["masters", "phd"]
  fundingType      String
  coverageDetails  Json              // {tuition: boolean, travel: boolean, living: boolean}
  deadline         DateTime
  applyUrl         String
  sourceUrl        String
  sourceDomain     String
  trustTier        Int               @default(3) // 1 = High, 3 = Low
  scamFlags        String[]
  verificationStatus String          @default("unverified")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  savedBy          SavedOpportunity[]
  verificationLogs VerificationLog[]
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  status        String      @default("interested") // interested, applied, won, lost
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([userId, opportunityId])
}

model ConversationLog {
  id            String   @id @default(uuid())
  userId        String
  role          String   // "user" or "agent"
  content       String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model VerificationLog {
  id            String      @id @default(uuid())
  opportunityId String
  checkedAt     DateTime    @default(now())
  status        String      // "live", "dead", "flagged"
  details       String?

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}
