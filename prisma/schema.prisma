generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String?           @unique
  googleId        String?           @unique
  whatsappNumber  String?           @unique
  profileJson     Json?
  goalStage       String            @default("goal_identified")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  countryCode     String?
  currency        String?
  fieldOfStudy    String?
  level           String?
  institution     String?
  graduationYear  Int?
  onboardingCompleted Boolean @default(false)
  tier            String            @default("free") // free, pro, elite
  
  conversationLogs ConversationLog[]
  savedOpportunities SavedOpportunity[]
  subscription    Subscription?
  usageLimit      UsageLimit?
}

// enum removed

model Opportunity {
  id                 String            @id @default(uuid())
  title              String
  type               String            @default("SCHOLARSHIP")
  sponsor            String
  orgType            String            @default("government") @map("org_type")
  hostCountry        String            @map("host_country")
  continent          String?
  eligibleCountries  String[]          @default([]) @map("eligible_countries")
  disciplines        String[]          @default([])
  degreeLevel        String[]          @map("degree_level")
  fundingType        String            @map("funding_type")
  coverageDetails    Json              @map("coverage_details")
  deadline           DateTime
  opensDate          DateTime?         @map("opens_date")
  applyUrl           String            @unique @map("apply_url")
  sourceUrl          String            @map("source_url")
  sourceDomain       String            @map("source_domain")
  trustTier          Int               @default(3) @map("trust_tier")
  scamFlag           Boolean           @default(false) @map("scam_flag")
  verificationStatus String            @default("unverified") @map("verification_status")
  description        String            @default("")
  eligibility        String            @default("")
  tags               String[]          @default([])
  submittedBy        String?           @map("submitted_by")
  submittedAt        DateTime?         @map("submitted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  savedBy            SavedOpportunity[]
  verificationLogs   VerificationLog[]
  intakes            Intake[]

  @@map("opportunities")
}

model Intake {
  id               String      @id @default(uuid())
  opportunityId    String      @map("opportunity_id")
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])

  intakeName       String      @map("intake_name")       // "2026/2027 Academic Year"
  opensDate        DateTime?   @map("opens_date")         // When applications OPEN
  deadlineDate     DateTime?   @map("deadline_date")      // When applications CLOSE
  notificationDate DateTime?   @map("notification_date")  // When winners are announced
  startDate        DateTime?   @map("start_date")         // When program BEGINS

  isRolling        Boolean     @default(false) @map("is_rolling")
  isPredicted      Boolean     @default(false) @map("is_predicted")

  status           String      @default("open")           // open, closed, upcoming, rolling, predicted

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@map("intakes")
}

model SavedOpportunity {
  id                String   @id @default(uuid())
  userId            String
  opportunityId     String
  status            String   @default("saved") // saved, researching, applying, submitted, interview, accepted, rejected, archived
  notes             String?
  checklistProgress Json?
  documents         Json?
  reminderDays      Int?
  reminderSet       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User                @relation(fields: [userId], references: [id])
  opportunity       Opportunity         @relation(fields: [opportunityId], references: [id])
  activities        OpportunityActivity[]

  @@unique([userId, opportunityId])
}

model OpportunityActivity {
  id                 String           @id @default(uuid())
  savedOpportunityId String
  userId             String
  action             String           // added, moved, updated_notes, uploaded_document, set_reminder
  fromStatus         String?
  toStatus           String?
  metadata           Json?
  createdAt          DateTime         @default(now())

  savedOpportunity   SavedOpportunity @relation(fields: [savedOpportunityId], references: [id], onDelete: Cascade)
}

model ConversationLog {
  id            String   @id @default(uuid())
  userId        String
  role          String   // "user" or "agent"
  content       String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model VerificationLog {
  id            String      @id @default(uuid())
  opportunityId String
  checkedAt     DateTime    @default(now())
  status        String      // "live", "dead", "flagged"
  details       String?

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  tier               String   // free, pro, elite
  status             String   // active, canceled, past_due, trialing
  processor          String?  // paystack, stripe
  localAmount        Float?
  currency           String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id])
}

model UsageLimit {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  savedOpportunitiesCount Int     @default(0)
  maxSaves               Int      @default(20)
  documentsUploadedCount Int      @default(0)
  maxDocuments           Int      @default(0)
  essaysDraftedThisMonth Int      @default(0)
  maxEssays              Int      @default(0)
  mentorCallsThisMonth   Int      @default(0)
  maxCalls               Int      @default(0)
  essayReviewsThisMonth  Int      @default(0)
  maxReviews             Int      @default(0)
  resetAt                DateTime?
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id])
}

model OpportunityDraft {
  id                 String   @id @default(uuid())
  title              String
  type               String   @default("SCHOLARSHIP")
  sponsor            String
  applyUrl           String   @map("apply_url")
  hostCountry        String   @default("Global") @map("host_country")
  deadline           DateTime?
  description        String   @default("")
  eligibility        String   @default("")
  status             String   @default("pending_review") // pending_review, approved, rejected
  submittedBy        String?  @map("submitted_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("opportunity_drafts")
}
