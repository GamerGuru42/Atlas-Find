generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String?           @unique
  googleId        String?           @unique
  whatsappNumber  String?           @unique
  profileJson     Json?
  goalStage       String            @default("goal_identified")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  conversationLogs ConversationLog[]
  savedOpportunities SavedOpportunity[]
}

model Opportunity {
  id                 String            @id @default(uuid())
  title              String
  sponsor            String
  orgType            String            @default("government") @map("org_type")
  hostCountry        String            @map("host_country")
  eligibleCountries  String[]          @default([]) @map("eligible_countries")
  disciplines        String[]          @default([])
  degreeLevel        String[]          @map("degree_level")
  fundingType        String            @map("funding_type")
  coverageDetails    Json              @map("coverage_details")
  deadline           DateTime
  opensDate          DateTime?         @map("opens_date")
  applyUrl           String            @map("apply_url")
  sourceUrl          String            @map("source_url")
  sourceDomain       String            @map("source_domain")
  trustTier          Int               @default(3) @map("trust_tier")
  scamFlag           Boolean           @default(false) @map("scam_flag")
  verificationStatus String            @default("unverified") @map("verification_status")
  description        String            @default("")
  eligibility        String            @default("")
  tags               String[]          @default([])
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  savedBy            SavedOpportunity[]
  verificationLogs   VerificationLog[]
  intakes            Intake[]

  @@map("opportunities")
}

model Intake {
  id               String      @id @default(uuid())
  opportunityId    String      @map("opportunity_id")
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])

  intakeName       String      @map("intake_name")       // "2026/2027 Academic Year"
  opensDate        DateTime?   @map("opens_date")         // When applications OPEN
  deadlineDate     DateTime?   @map("deadline_date")      // When applications CLOSE
  notificationDate DateTime?   @map("notification_date")  // When winners are announced
  startDate        DateTime?   @map("start_date")         // When program BEGINS

  isRolling        Boolean     @default(false) @map("is_rolling")
  isPredicted      Boolean     @default(false) @map("is_predicted")

  status           String      @default("open")           // open, closed, upcoming, rolling, predicted

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@map("intakes")
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  status        String      @default("interested") // interested, applied, won, lost
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([userId, opportunityId])
}

model ConversationLog {
  id            String   @id @default(uuid())
  userId        String
  role          String   // "user" or "agent"
  content       String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model VerificationLog {
  id            String      @id @default(uuid())
  opportunityId String
  checkedAt     DateTime    @default(now())
  status        String      // "live", "dead", "flagged"
  details       String?

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}
