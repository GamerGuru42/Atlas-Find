# ==============================================================================
# AtlasFind — Authoritative Production Environment Variable Specification
#
# Copy this template to .env or .env.local to configure your deployment.
# NEVER commit real credentials, secret keys, or live API tokens to git.
# All variables listed below are actively referenced across AtlasFind runtimes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Supabase / Prisma 6)
# ------------------------------------------------------------------------------
# Transaction-pooled connection string (used by Prisma Client in Serverless Functions)
# Format: postgresql://[user]:[password]@[host]:6543/[database]?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session connection string (bypasses PgBouncer on port 5432; REQUIRED for migrations & DDL)
# Format: postgresql://[user]:[password]@[host]:5432/[database]
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & Client Integration
# ------------------------------------------------------------------------------
# Supabase project URL (accessible to both server and browser)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase Anonymous/Public API Key (safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Supabase Service Role Secret Key (Server-only; used for administrative user sync)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Models
# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API Key (Server-only)
GEMINI_API_KEY="AIzaSyYourProductionGeminiApiKey"

# (Optional fallback key name supported by Google AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Centralized Model Identifiers (defaults to production models if unset)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_REASONING_MODEL="gemini-2.5-pro"

# ------------------------------------------------------------------------------
# 4. Administrative Protected Endpoints
# ------------------------------------------------------------------------------
# Canonical Secret Token for /api/admin/* endpoints
# Authenticate via HTTP Header: "Authorization: Bearer <ADMIN_SECRET_KEY>"
ADMIN_SECRET_KEY="your-random-64-character-hex-string-for-admin-endpoints"

# (Legacy aliases supported for backward compatibility: ADMIN_API_KEY, ADMIN_PASSWORD)
ADMIN_API_KEY=""
ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# 5. Scheduled Automation (Vercel Cron Jobs)
# ------------------------------------------------------------------------------
# Secret Token for scheduled cron triggers (/api/cron/check-deadlines, /api/cron/verify-opportunities)
# Automatically injected by Vercel Cron via HTTP Header: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="your-random-64-character-hex-string-for-vercel-crons"

# ------------------------------------------------------------------------------
# 6. Payment Gateways: Stripe (Global Payments)
# ------------------------------------------------------------------------------
# Stripe Secret Key (Server-only)
STRIPE_SECRET_KEY="sk_live_..."

# Stripe Webhook HMAC Signing Secret (Server-only; verifies /api/payments/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Publishable Key (Client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Stripe Price Identifiers (Created in Stripe Dashboard Products)
STRIPE_PRICE_PRO_MONTHLY="price_1Q..."
STRIPE_PRICE_PRO_YEARLY="price_1Q..."
STRIPE_PRICE_ELITE_MONTHLY="price_1Q..."
STRIPE_PRICE_ELITE_YEARLY="price_1Q..."

# ------------------------------------------------------------------------------
# 7. Payment Gateways: Paystack (African Local Currency Payments)
# ------------------------------------------------------------------------------
# Paystack Secret Key (Server-only; used for initialization and HMAC webhook verification)
PAYSTACK_SECRET_KEY="sk_live_..."

# Paystack Public Key (Client-side and server verification)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_..."
PAYSTACK_PUBLIC_KEY="pk_live_..."

# ------------------------------------------------------------------------------
# 8. Application URL & Edge Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# Canonical Public URL of the deployment
NEXT_PUBLIC_APP_URL="https://atlas-find.vercel.app"
APP_URL="https://atlas-find.vercel.app"

# Optional: Upstash Redis for distributed Edge rate-limiting (in-memory fallback active if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
